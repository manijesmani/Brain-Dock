# Anything not needed to run the application in production.

.venv/
venv/
__pycache__/
*.py[cod]

# Secrets. The container gets its configuration from the environment.
.env
.env.*

# Local state that must never be baked into an image.
media/
staticfiles/
celerybeat-schedule*
*.log

# Tooling and tests: neither is installed in the production requirements.
tests/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
