# Copy to .env and fill in. .env is never committed.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me

DATABASE_URL=postgres://braindock:braindock@127.0.0.1:5432/braindock

# Development only. Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required in production, where neither has a fallback. In development
# ALLOWED_HOSTS defaults to the local names and only needs setting to add a
# tunnel's hostname while testing the Telegram webhook, e.g.
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,something.trycloudflare.com
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Moves the admin off the address every scanner tries first. Keep the
# trailing slash.
DJANGO_ADMIN_URL_PATH=admin/

# Rate limits. The defaults are generous for one person; tighten if exposed
# more widely.
LOGIN_THROTTLE_RATE=10/min
GUEST_THROTTLE_RATE=30/hour
SIGNUP_THROTTLE_RATE=20/hour
WEBHOOK_THROTTLE_RATE=120/min
USER_THROTTLE_RATE=2000/hour
ANON_THROTTLE_RATE=120/hour

# Accounts. Guests and regular accounts may hold this many ideas; special
# accounts, made by the owner from the user panel, and the owner (the
# superuser) have no limit.
FREE_IDEA_LIMIT=2
# The owner's Telegram username, without the @, where a subscription is
# bought: «خرید اشتراک» and the sign-up page open a chat with it. Empty hides
# those buttons.
OWNER_TELEGRAM_USERNAME=manijesmani

# Phase 6. The username is used for the link shown in settings.
TELEGRAM_BOT_USERNAME=BrainDockBot
TELEGRAM_BOT_TOKEN=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Public address of the app, used for the links the bot sends.
SITE_URL=http://localhost:5173
