# Configuration for the Docker deployment. Copy to .env and fill in.
#
# This is not the same file as backend/.env, which configures Django when it
# is run directly on the host during development. Only this one is read by
# docker compose.

# --------------------------------------------------------------------------
# Required. The stack refuses to start if any of these is empty.
# --------------------------------------------------------------------------

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# The hostnames Django will answer to. 127.0.0.1 is included so the
# container's own health check can reach it.
DJANGO_ALLOWED_HOSTS=braindock.example.com,127.0.0.1

# Scheme included, unlike ALLOWED_HOSTS. Django compares the Origin header
# against these on every write.
DJANGO_CSRF_TRUSTED_ORIGINS=https://braindock.example.com

# Where the app is reachable from outside. The Telegram bot puts this in the
# links it sends.
SITE_URL=https://braindock.example.com

# The name Nginx serves. Must match the certificate.
BD_SERVER_NAME=braindock.example.com

# --------------------------------------------------------------------------
# Optional, with defaults
# --------------------------------------------------------------------------

POSTGRES_DB=braindock
POSTGRES_USER=braindock

# Keep the trailing slash and no leading one. Compose derives the Nginx
# location from this, so the two cannot drift apart.
DJANGO_ADMIN_URL_PATH=admin/

# Gunicorn workers and Celery worker processes.
WEB_CONCURRENCY=3
CELERY_CONCURRENCY=2

# Published ports. Change only if something else on the host owns 80/443.
HTTP_PORT=80
HTTPS_PORT=443

# Image tag, so a deploy can be rolled back to a previous build.
BRAINDOCK_TAG=latest

# --------------------------------------------------------------------------
# Telegram. The bot stays dormant while the token is empty.
# --------------------------------------------------------------------------

TELEGRAM_BOT_USERNAME=BrainDockBot
TELEGRAM_BOT_TOKEN=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# --------------------------------------------------------------------------
# Rate limits
# --------------------------------------------------------------------------

LOGIN_THROTTLE_RATE=10/min
WEBHOOK_THROTTLE_RATE=120/min
USER_THROTTLE_RATE=2000/hour
ANON_THROTTLE_RATE=120/hour
