# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Django
*.log
/backend/media/
/backend/staticfiles/

# Celery beat's record of when each entry last ran, rewritten by every running
# scheduler. The pattern also catches the files some storage backends write
# beside it, such as SQLite's -wal and -shm.
celerybeat-schedule*

# Environment
.env
.env.*
!.env.example

# Node
node_modules/
# dist.new and dist.old exist only while deploy/deploy.sh swaps a build in.
/frontend/dist*/
npm-debug.log*

# Testing and tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Database dumps. They hold copies of every idea and attachment.
/backups/

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
